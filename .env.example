# Network: mainnet | fuji
NETWORK=mainnet

# P-Chain JSON-RPC endpoint (defaults to the public endpoint for the network)
# PCHAIN_RPC_URL=https://api.avax.network/ext/bc/P

# Enumeration source strategy: pchain (default) | dataapi
ENUM_SOURCE=pchain

# AvaCloud Data API (Glacier) — optional enrichment
DATA_API_BASE=https://glacier-api.avax.network
# DATA_API_KEY=your-key-here
# ENRICH=true            # defaults to true only when DATA_API_KEY is set

# Local store: JSON files, one per collection, committed to the repo
# DATA_DIR=data/mainnet         # defaults to data/<network>

# Tuning
CONCURRENCY=4
PERSIST_GENESIS=false
PERSIST_RAW=false
REPORT_DIR=reports
